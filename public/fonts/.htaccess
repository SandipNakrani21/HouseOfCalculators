# Public artwork/font/media responses served directly by Hostinger.
# No routing rules: preserve Hostinger's generated Node.js configuration.
# Restricted to assets; never applies to HTML or the Adsterra document.
<IfModule mod_headers.c>
  <FilesMatch "(?i)[.](svg|png|jpe?g|gif|webp|avif|ico|woff2?|mp4|webm)$">
    Header onsuccess unset X-Content-Type-Options
    Header onsuccess unset Strict-Transport-Security
    Header onsuccess unset X-Frame-Options
    Header onsuccess unset Referrer-Policy
    Header onsuccess unset Content-Security-Policy
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  </FilesMatch>
</IfModule>
